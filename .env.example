# Local dev works with zero config. Everything below is optional until deploy.

# Database — defaults to a local SQLite file when unset.
DATABASE_URL="file:./local.db"
# For Turso: DATABASE_URL="libsql://<db>-<org>.turso.io" and DATABASE_AUTH_TOKEN="..."
# The Vercel Turso integration injects TURSO_DATABASE_URL + TURSO_AUTH_TOKEN instead.
DATABASE_AUTH_TOKEN=""
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Passcode gate. When empty the app is open (fine for localhost).
APP_PASSCODE=""

# Web push for the daily morning brief. Generate with: npm run keys:vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:sandeepkondury@gmail.com"

# Protects /api/cron/remind and /api/cron/water. Set the same value in Vercel
# and in the GitHub Actions secrets (CRON_SECRET + APP_URL) so water pings can
# fire every two hours — Hobby cron is once a day.
CRON_SECRET=""

# Apple Health sync key for /api/health/ingest. Required by the iPhone app.
# Generate one with: openssl rand -hex 32
HEALTH_INGEST_SECRET=""

# The coach. Without a key the built-in guardrails still run.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
# Only for a gateway or proxy. Unset means api.openai.com.
OPENAI_BASE_URL=""

# Absolute URL used in reminder links and the iPhone Health bridge.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
