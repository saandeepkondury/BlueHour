# Local dev works with zero config. Everything below is optional until deploy.

# Database — defaults to a local SQLite file when unset.
DATABASE_URL="file:./local.db"
# For Turso: DATABASE_URL="libsql://<db>-<org>.turso.io" and DATABASE_AUTH_TOKEN="..."
DATABASE_AUTH_TOKEN=""

# Passcode gate. When empty the app is open (fine for localhost).
APP_PASSCODE=""

# Daily reminder email (Resend).
RESEND_API_KEY=""
REMINDER_FROM="Blue Hour <onboarding@resend.dev>"

# Web push. Generate with: npm run keys:vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:sandeepkondury@gmail.com"

# Protects /api/cron/remind. Vercel sets this automatically for Cron Jobs.
CRON_SECRET=""

# Apple Health sync key for /api/health/ingest. You can also mint one in the app
# at Settings -> Apple Health sync, which stores it in the database instead.
HEALTH_INGEST_SECRET=""

# The coach. Without a key the built-in guardrails still run.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
# Only for a gateway or proxy. Unset means api.openai.com.
OPENAI_BASE_URL=""

# Absolute URL used in reminder links and the Shortcut instructions.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
