# Local dev works with zero config. Everything below is optional until deploy.

# Database — defaults to a local SQLite file when unset.
DATABASE_URL="file:./local.db"
# For Turso: DATABASE_URL="libsql://<db>-<org>.turso.io" and DATABASE_AUTH_TOKEN="..."
# The Vercel Turso integration injects TURSO_DATABASE_URL + TURSO_AUTH_TOKEN instead.
DATABASE_AUTH_TOKEN=""
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Sign in with Apple.
# APPLE_CLIENT_ID — audiences to verify (iOS bundle id and/or Services ID), comma-separated.
# NEXT_PUBLIC_APPLE_CLIENT_ID — Services ID for the web button (must also be listed above,
#   or set alone; it is merged into the audience list). Without the public id the web
#   Apple button is hidden; without any audience the Apple API answers 503.
APPLE_CLIENT_ID=""
NEXT_PUBLIC_APPLE_CLIENT_ID=""

# Web push for the daily morning brief. Generate with: npm run keys:vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:sandeepkondury@gmail.com"

# Protects /api/cron/remind and /api/cron/water. Set the same value in Vercel
# and in the GitHub Actions secrets (CRON_SECRET + APP_URL) so water pings can
# fire on cup-paced 9am–8pm local slots — Hobby cron is once a day.
CRON_SECRET=""

# Upgrade path only. The iPhone app now signs in and keeps a per-device token,
# but a phone still holding this shared key keeps syncing while the deploy has
# exactly one account. Leave empty for a new deploy.
HEALTH_INGEST_SECRET=""

# Exercise demo GIFs on Strength / Core (WorkoutX).
WORKOUTX_API_KEY=""

# The coach. Without a key the built-in guardrails still run.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
# Only for a gateway or proxy. Unset means api.openai.com.
OPENAI_BASE_URL=""

# Absolute URL used in reminder links and the iPhone Health bridge.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
